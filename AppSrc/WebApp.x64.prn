37632>>>                // If from child, this is a probably a parent lookup from a Zoom
37632>>>                Case Break
37633>>>
37633>>>            Case (NavigateData.eNavigateType = nfFromMain)
37636>>>                // If from main, this is a probably a main-file lookup from a Zoom
37636>>>                WebSet pbRender of oDetailButton to False
37637>>>                Case Break
37638>>>
37638>>>            Case Else // must be nfUndefined
37638>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37638>>>
37638>>>        Case End
37638>>>
37638>>>    End_Procedure
