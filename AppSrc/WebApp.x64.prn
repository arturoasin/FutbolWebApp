37757>>>
37757>>>        If (NavigateData.bReadOnly) Begin
37759>>>            WebSet pbRender of oEditBtn to True
37760>>>        End
37760>>>>
37760>>>        Else Begin
37761>>>            WebSet pbRender of oSaveBtn to True
37762>>>            WebSet pbRender of oCancelChangesBtn to True
37763>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37764>>>        End
