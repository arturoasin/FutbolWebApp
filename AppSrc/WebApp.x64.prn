38502>>>        Get GetNavigateData to NavigateData
38503>>>        Get HasRecord of hoDD to bHasRecord
38504>>>
38504>>>        // let's hide all buttons and then Show the ones we want
38504>>>        WebSet pbRender of oEditBtn to False
38505>>>        WebSet pbRender of oSaveBtn to False
38506>>>        WebSet pbRender of oCancelChangesBtn to False
38507>>>        WebSet pbRender of oDeleteBtn to False
38508>>>
38508>>>        If (NavigateData.bReadOnly) Begin
38510>>>            WebSet pbRender of oEditBtn to True
38511>>>        End
38511>>>>
38511>>>        Else Begin
38512>>>            WebSet pbRender of oSaveBtn to True
38513>>>            WebSet pbRender of oCancelChangesBtn to True
38514>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38515>>>        End
38515>>>>
38515>>>    End_Procedure
