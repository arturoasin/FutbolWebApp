37545>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37548>>>        WebSet pbRender of oNewButton to True
37549>>>        WebSet pbRender of oDetailButton to True
37550>>>
37550>>>        Case Begin
37550>>>            Case (NavigateData.eNavigateType = nfFromParent)
37552>>>                // If from parent, this is a constrained drill down
37552>>>                Case Break
37553>>>
37553>>>            Case (NavigateData.eNavigateType = nfFromChild)
37556>>>                // If from child, this is a probably a parent lookup from a Zoom
37556>>>                Case Break
37557>>>
37557>>>            Case (NavigateData.eNavigateType = nfFromMain)
37560>>>                // If from main, this is a probably a main-file lookup from a Zoom
37560>>>                WebSet pbRender of oDetailButton to False
37561>>>                Case Break
37562>>>
37562>>>            Case Else // must be nfUndefined
37562>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37562>>>
37562>>>        Case End
37562>>>
37562>>>    End_Procedure
37563>>>
37563>>>
37563>>>End_Object 
