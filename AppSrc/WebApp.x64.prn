38856>>>    Procedure SetActionButtons
38859>>>        tWebNavigateData NavigateData
38859>>>        tWebNavigateData NavigateData
38859>>>        Boolean bHasRecord
38859>>>        Handle hoDD
38859>>>        Boolean bNuevo
38859>>>        
38859>>>        Get Server to hoDD
38860>>>        Get GetNavigateData to NavigateData
38861>>>        Get HasRecord of hoDD to bHasRecord
38862>>>        Move (bHasRecord = False) to bNuevo
38863>>>        WebSet pbEnabled of ojugadorNombre to bNuevo
38864>>>        WebSet pbEnabled of ojugadorApellido to bNuevo  
38865>>>        
38865>>>        // let's hide all buttons and then Show the ones we want
38865>>>        WebSet pbRender of oEditBtn to False
38866>>>        WebSet pbRender of oSaveBtn to False
38867>>>        WebSet pbRender of oCancelChangesBtn to False
38868>>>        WebSet pbRender of oDeleteBtn to False
38869>>>
38869>>>        If (NavigateData.bReadOnly) Begin
38871>>>            WebSet pbRender of oEditBtn to True
38872>>>        End
38872>>>>
38872>>>        Else Begin
38873>>>            WebSet pbRender of oSaveBtn to True
38874>>>            WebSet pbRender of oCancelChangesBtn to True
38875>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38876>>>        End
38876>>>>
38876>>>    End_Procedure
