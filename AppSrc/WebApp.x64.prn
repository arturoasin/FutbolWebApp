38948>>>                // If from main, this is a propbably a main file Select to Zoom.
38948>>>                Case Break
38949>>>
38949>>>            Case (NavigateData.eNavigateType = nfFromParent)
38952>>>                // If from parent, this is a constrained drill down.
38952>>>                Case Break
38953>>>
