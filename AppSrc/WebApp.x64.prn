37782>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37782>>>                Case Break
37783>>>
37783>>>            Case Else // must be nfUndefined
37783>>>
37783>>>        Case End
37783>>>
37783>>>        Send SetActionButtons
37784>>>
37784>>>    End_Procedure
37785>>>
