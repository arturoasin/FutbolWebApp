38501>>>        Get HasRecord of hoDD to bHasRecord
38502>>>
38502>>>        // let's hide all buttons and then Show the ones we want
38502>>>        WebSet pbRender of oEditBtn to False
38503>>>        WebSet pbRender of oSaveBtn to False
38504>>>        WebSet pbRender of oCancelChangesBtn to False
38505>>>        WebSet pbRender of oDeleteBtn to False
38506>>>
38506>>>        If (NavigateData.bReadOnly) Begin
38508>>>            WebSet pbRender of oEditBtn to True
38509>>>        End
38509>>>>
38509>>>        Else Begin
38510>>>            WebSet pbRender of oSaveBtn to True
38511>>>            WebSet pbRender of oCancelChangesBtn to True
38512>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38513>>>        End
38513>>>>
