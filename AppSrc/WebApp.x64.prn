38475>>>    Procedure SetActionButtons
38478>>>        tWebNavigateData NavigateData
38478>>>        tWebNavigateData NavigateData
38478>>>        Boolean bHasRecord
38478>>>        Handle hoDD
38478>>>
38478>>>        Get Server to hoDD
38479>>>        Get GetNavigateData to NavigateData
38480>>>        Get HasRecord of hoDD to bHasRecord
38481>>>
38481>>>        // let's hide all buttons and then Show the ones we want
38481>>>        WebSet pbRender of oEditBtn to False
38482>>>        WebSet pbRender of oSaveBtn to False
38483>>>        WebSet pbRender of oCancelChangesBtn to False
38484>>>        WebSet pbRender of oDeleteBtn to False
38485>>>
38485>>>        If (NavigateData.bReadOnly) Begin
38487>>>            WebSet pbRender of oEditBtn to True
38488>>>        End
38488>>>>
38488>>>        Else Begin
38489>>>            WebSet pbRender of oSaveBtn to True
38490>>>            WebSet pbRender of oCancelChangesBtn to True
38491>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38492>>>        End
38492>>>>
38492>>>    End_Procedure
38493>>>
