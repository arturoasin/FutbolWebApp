37778>>>        Case Begin
37778>>>            Case (NavigateData.eNavigateType = nfFromMain)
37780>>>                // If from main, this is a propbably a main file Select to Zoom.
37780>>>                Case Break
37781>>>
37781>>>            Case (NavigateData.eNavigateType = nfFromParent)
37784>>>                // If from parent, this is a constrained drill down.
37784>>>                Case Break
37785>>>
37785>>>            Case (NavigateData.eNavigateType = nfFromChild)
37788>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37788>>>                Case Break
37789>>>
37789>>>            Case Else // must be nfUndefined
37789>>>
37789>>>        Case End
37789>>>
37789>>>        Send SetActionButtons
37790>>>
37790>>>    End_Procedure
37791>>>
37791>>>End_Object 
