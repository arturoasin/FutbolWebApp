37638>>>                // If from main, this is a probably a main-file lookup from a Zoom
37638>>>                WebSet pbRender of oDetailButton to False
37639>>>                Case Break
37640>>>
37640>>>            Case Else // must be nfUndefined
37640>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37640>>>
37640>>>        Case End
37640>>>
37640>>>    End_Procedure
