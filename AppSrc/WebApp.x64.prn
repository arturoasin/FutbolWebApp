37632>>>                // If from main, this is a probably a main-file lookup from a Zoom
37632>>>                WebSet pbRender of oDetailButton to False
37633>>>                Case Break
37634>>>
37634>>>            Case Else // must be nfUndefined
37634>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37634>>>
37634>>>        Case End
37634>>>
37634>>>    End_Procedure
