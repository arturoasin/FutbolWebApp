38913>>>        Get HasRecord of hoDD to bHasRecord
38914>>>
38914>>>        // let's hide all buttons and then Show the ones we want
38914>>>        WebSet pbRender of oEditBtn to False
38915>>>        WebSet pbRender of oSaveBtn to False
38916>>>        WebSet pbRender of oCancelChangesBtn to False
38917>>>        WebSet pbRender of oDeleteBtn to False
38918>>>
38918>>>        If (NavigateData.bReadOnly) Begin
38920>>>            WebSet pbRender of oEditBtn to True
38921>>>        End
38921>>>>
38921>>>        Else Begin
38922>>>            WebSet pbRender of oSaveBtn to True
38923>>>            WebSet pbRender of oCancelChangesBtn to True
38924>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38925>>>        End
38925>>>>
