38085>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
38086>>>>>        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
38087>>>>>        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True
