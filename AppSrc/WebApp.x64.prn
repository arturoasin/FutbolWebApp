38892>>>                Case Break
38893>>>
38893>>>            Case (NavigateData.eNavigateType = nfFromParent)
38896>>>                // If from parent, this is a constrained drill down.
38896>>>                Case Break
38897>>>
38897>>>            Case (NavigateData.eNavigateType = nfFromChild)
38900>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38900>>>                Case Break
38901>>>
38901>>>            Case Else // must be nfUndefined
38901>>>
38901>>>        Case End
38901>>>
38901>>>        Send SetActionButtons
