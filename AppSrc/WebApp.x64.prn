38850>>>        // let's hide all buttons and then Show the ones we want
38850>>>        WebSet pbRender of oEditBtn to False
38851>>>        WebSet pbRender of oSaveBtn to False
38852>>>        WebSet pbRender of oCancelChangesBtn to False
38853>>>        WebSet pbRender of oDeleteBtn to False
38854>>>
38854>>>        If (NavigateData.bReadOnly) Begin
