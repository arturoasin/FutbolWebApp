37788>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37788>>>                Case Break
37789>>>
37789>>>            Case Else // must be nfUndefined
37789>>>
37789>>>        Case End
37789>>>
37789>>>        Send SetActionButtons
37790>>>
37790>>>    End_Procedure
