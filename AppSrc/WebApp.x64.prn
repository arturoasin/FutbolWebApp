37528>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37531>>>        WebSet pbRender of oNewButton to True
37532>>>        WebSet pbRender of oDetailButton to True
37533>>>
37533>>>        Case Begin
37533>>>            Case (NavigateData.eNavigateType = nfFromParent)
37535>>>                // If from parent, this is a constrained drill down
37535>>>                Case Break
37536>>>
37536>>>            Case (NavigateData.eNavigateType = nfFromChild)
37539>>>                // If from child, this is a probably a parent lookup from a Zoom
37539>>>                Case Break
37540>>>
37540>>>            Case (NavigateData.eNavigateType = nfFromMain)
37543>>>                // If from main, this is a probably a main-file lookup from a Zoom
37543>>>                WebSet pbRender of oDetailButton to False
37544>>>                Case Break
37545>>>
37545>>>            Case Else // must be nfUndefined
37545>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37545>>>
37545>>>        Case End
37545>>>
37545>>>    End_Procedure
