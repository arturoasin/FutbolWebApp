38091>>>>>Procedure Backout
38093>>>>>    Integer iEquipos
38093>>>>>    Forward Send Backout
38095>>>>>    If (equipo.ID <> 0) Begin
38097>>>>>        Move liga.Equipos to iEquipos
38098>>>>>        If (iEquipos > 0) Begin
38100>>>>>            Move (iEquipos - 1) to liga.Equipos
38101>>>>>        End
38101>>>>>>
38101>>>>>        Else Begin
38102>>>>>            Send UserError "No hay equipos que quitar en la liga anterior." ""
38103>>>>>        End
38103>>>>>>
38103>>>>>    End
38103>>>>>>
38103>>>>>End_Procedure
38104>>>>>
38104>>>>>Procedure Update
38106>>>>>    Integer iEquipos iMax
38106>>>>>    Forward Send Update
38108>>>>>    Move liga.Equipos to iEquipos
38109>>>>>    Move liga.EquiposMax to iMax
38110>>>>>    If (iEquipos < iMax) Begin
38112>>>>>        Move (iEquipos + 1) to liga.Equipos
38113>>>>>    End
38113>>>>>>
38113>>>>>    Else Begin
38114>>>>>        Send UserError "No hay sitio en la liga para el nuevo equipo." ""
38115>>>>>    End
38115>>>>>>
38115>>>>>End_Procedure
