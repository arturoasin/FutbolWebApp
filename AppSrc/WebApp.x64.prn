38912>>>    Procedure SetActionButtons
38915>>>        tWebNavigateData NavigateData
38915>>>        tWebNavigateData NavigateData
38915>>>        Boolean bHasRecord
38915>>>        Handle hoDD
38915>>>        Boolean bNuevo
38915>>>        
38915>>>        Get Server to hoDD
38916>>>        Get GetNavigateData to NavigateData
38917>>>        Get HasRecord of hoDD to bHasRecord
38918>>>        Move (bHasRecord = False) to bNuevo
38919>>>        WebSet pbEnabled of ojugadorNombre to bNuevo
38920>>>        WebSet pbEnabled of ojugadorApellido to bNuevo  
38921>>>        
38921>>>        // let's hide all buttons and then Show the ones we want
38921>>>        WebSet pbRender of oEditBtn to False
38922>>>        WebSet pbRender of oSaveBtn to False
38923>>>        WebSet pbRender of oCancelChangesBtn to False
38924>>>        WebSet pbRender of oDeleteBtn to False
38925>>>
38925>>>        If (NavigateData.bReadOnly) Begin
38927>>>            WebSet pbRender of oEditBtn to True
38928>>>        End
38928>>>>
38928>>>        Else Begin
38929>>>            WebSet pbRender of oSaveBtn to True
38930>>>            WebSet pbRender of oCancelChangesBtn to True
38931>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38932>>>        End
38932>>>>
38932>>>    End_Procedure
